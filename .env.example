# ─────────────────────────────────────────────────────────────────────────────
# PrivateNoteCapital.com — Foreclosure & Auction Intelligence
# Copy to .env.local for development. Set real values in Netlify for production.
# The app builds and renders with graceful empty states even if these are unset.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public, browser-safe — RLS enforced) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase service role (SERVER ONLY — never expose to the browser) ──
# Used by imports, lead logging, and admin operations. Do NOT prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE=

# ── GRCRM lead webhook (SERVER ONLY) ──
# Leads (financing, watchlist, saves, reviews) POST here. Token stays in the URL.
GRCRM_LEAD_WEBHOOK_URL=
# GRCRM_WEBHOOK_URL is accepted as a fallback.
GRCRM_WEBHOOK_URL=
# Optional HMAC-SHA256 signing secret; when set, requests carry X-PNC-Signature.
GRCRM_WEBHOOK_SECRET=

# ── Email fallback (OPTIONAL) — set ONE provider; auto-detected in this order ──
RESEND_API_KEY=
WEB3FORMS_ACCESS_KEY=
FORMSUBMIT_EMAIL=
NOTIFY_EMAIL=
NOTIFY_FROM=

# ── Site URL (OPTIONAL override) ──
# Canonical/OG URL for the single combined site. Defaults to https://privatenotecapital.com.
NEXT_PUBLIC_SITE_URL=

# ── Data-source integrations (PLACEHOLDERS — inactive until approved) ──
# See docs/propertyradar-integration.md. Do NOT hardcode IDs/keys in code.
PROPERTYRADAR_API_KEY=
PROPERTYRADAR_AFFILIATE_ID=
FORECLOSURERADAR_AFFILIATE_URL=
